# Secrets only. Copy to .env (ignored by git), restrict access: chmod 600 .env
# Names are referenced from config.yaml (secret_env, api_token_env, mcp_token_env).

# Same value as GOOSE_SERVER__SECRET_KEY on the agent side
AGENT_WORK_SECRET=

# Bearer tokens for the local HTTP API and MCP endpoint
ACPGW_API_TOKEN=
ACPGW_MCP_TOKEN=
